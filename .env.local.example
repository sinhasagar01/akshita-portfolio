# Copy this file to .env.local and fill in real values before running locally.
# Never commit .env.local to git.

# Production origin, no trailing slash. Used for metadataBase in app/layout.tsx.
NEXT_PUBLIC_SITE_URL=https://www.akshitas.com

# Keystatic runs DEV-ONLY with local storage, by decision (GH-9). /studio is the
# prod editor and middleware 404s /keystatic in production. So the Keystatic
# GitHub OAuth vars (KEYSTATIC_GITHUB_CLIENT_ID, KEYSTATIC_GITHUB_CLIENT_SECRET,
# KEYSTATIC_SECRET) are NOT needed anywhere. Do not re-add them.

# /studio GitHub write boundary (GH-1). All server-side only, never NEXT_PUBLIC_.
# Fine-grained PAT scoped to Contents read and write on sinhasagar01/akshita-portfolio ONLY.
# STUDIO_GITHUB_TOKEN=
# Owner login password for the /studio write gate.
# STUDIO_OWNER_PASSWORD=
# 32-byte hex, signs the studio_session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STUDIO_SESSION_SECRET=
# Set to "github" to enable the GitHub commit path. Default off = fs/no-op.
# STUDIO_WRITE_MODE=

# Durable login throttle (GH-7). Server-side only, never NEXT_PUBLIC_.
# Upstash Redis REST creds from the Upstash console. Without both, the login
# throttle falls back to an in-memory counter (fine for local dev). Required in
# prod so the throttle survives cold starts and spans serverless instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
